	partition 'Date' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "date.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNo", Int64.Type}, {"Month", type text}, {"YearMonth", Int64.Type}, {"Year Month", type text}, {"Weekday", type text}, {"WeekdayNo", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
